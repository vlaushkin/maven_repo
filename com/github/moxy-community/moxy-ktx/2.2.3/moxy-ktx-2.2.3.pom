  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.moxy-community</groupId>
  <artifactId>moxy-ktx</artifactId>
  <version>2.2.3</version>
  <name>Moxy Kotlin Extensions</name>
  <description>Kotlin extensions for Moxy</description>
  <url>https://github.com/moxy-community/</url>
  <inceptionYear>2019</inceptionYear>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>moxy-community</id>
      <name>Moxy Community</name>
      <email>moxy-community@yandex.ru</email>
      <url>https://github.com/moxy-community/</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git@github.com:moxy-community/Moxy.git</connection>
    <developerConnection>scm:git@github.com:moxy-community/Moxy.git</developerConnection>
    <url>https://github.com/moxy-community/Moxy.git</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.github.moxy-community</groupId>
      <artifactId>moxy</artifactId>
      <version>2.2.3</version>
